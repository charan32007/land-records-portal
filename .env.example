# Copy this file to .env and fill in real values. Never commit .env itself.
# Do not put real keys in THIS file either -- it is meant to be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-to-something-strong

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Get a Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# SMS / OTP delivery
# ---------------------------------------------------------------------------
# none | twilio | msg91 | fast2sms
# While SMS_PROVIDER=none no text is sent and the OTP is shown in the UI.
# As soon as a provider is set, the OTP is never returned over the API,
# whatever OTP_DEBUG_MODE says.
SMS_PROVIDER=none

# Country code assumed for plain 10-digit numbers (91 = India).
DEFAULT_COUNTRY_CODE=91

# Only has any effect while SMS_PROVIDER=none.
OTP_DEBUG_MODE=true

# --- Twilio (works worldwide; trial accounts can only text verified numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- MSG91 (India). Needs a DLT-registered sender ID and an OTP template
# containing an ##OTP## variable.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# --- Fast2SMS (India only, OTP route)
FAST2SMS_API_KEY=

# --- OTP abuse limits (per phone number, per window)
OTP_REQUESTS_PER_WINDOW=3
OTP_VERIFY_ATTEMPTS_PER_WINDOW=5
OTP_RATE_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# Login form defaults (frontend convenience only)
# ---------------------------------------------------------------------------
# Pre-fills the phone/name fields on the login screen. Leave blank for a
# public deployment so citizens see an empty form.
DEFAULT_LOGIN_PHONE=9743476555
DEFAULT_LOGIN_NAME=Registry Staff Admin